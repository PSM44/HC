{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hc:schema:specialist-problem-pack:v0.1",
  "title": "HC SpecialistProblemPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "escalation_id",
    "task_id",
    "work_unit_id",
    "issue_id",
    "attempt_id",
    "requested_by_role",
    "problem_statement",
    "requested_output",
    "allowed_context_refs",
    "prohibited_actions",
    "permissions",
    "mutation_scope",
    "budget",
    "stop_conditions"
  ],
  "properties": {
    "contract_version": {
      "const": "hc.specialist-problem-pack.v0.1"
    },
    "escalation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_by_role": {
      "enum": [
        "MORCH",
        "RORCH"
      ]
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1
    },
    "requested_output": {
      "type": "string",
      "minLength": 1
    },
    "allowed_context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibited_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_read",
        "filesystem_write",
        "process_execution",
        "network_access",
        "credential_use",
        "canonical_mutation",
        "external_publication"
      ],
      "properties": {
        "filesystem_read": {
          "type": "boolean"
        },
        "filesystem_write": {
          "type": "boolean"
        },
        "process_execution": {
          "type": "boolean"
        },
        "network_access": {
          "type": "boolean"
        },
        "credential_use": {
          "type": "boolean"
        },
        "canonical_mutation": {
          "type": "boolean"
        },
        "external_publication": {
          "type": "boolean"
        }
      }
    },
    "mutation_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "allowed_tools"
      ],
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_elapsed_seconds": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "max_cost_units": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "allowed_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
