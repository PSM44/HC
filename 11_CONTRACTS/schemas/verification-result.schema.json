{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hc:schema:verification-result:v0.1",
  "title": "HC VerificationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "verification_id",
    "issue_id",
    "attempt_id",
    "verifier_id",
    "status",
    "criteria",
    "evidence_refs",
    "invariants_satisfied",
    "contradictions",
    "terminal"
  ],
  "properties": {
    "contract_version": {
      "const": "hc.verification-result.v0.1"
    },
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "work_unit_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INSUFFICIENT_EVIDENCE",
        "CONTRADICTORY_EVIDENCE"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "verdict",
          "evidence_refs"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason_code": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants_satisfied": {
      "type": "boolean"
    },
    "contradictions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terminal": {
      "type": "boolean"
    }
  }
}
